<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Para Noni ✨🤍</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    overflow: hidden;
    font-family: "Segoe UI", sans-serif;
    background: linear-gradient(180deg, #fffdf0, #fff1a8, #ffd95c);
    color: #604600;
}

/* Fondo */
.fondo {
    position: fixed;
    inset: 0;
    overflow: hidden;
}

.sol {
    position: absolute;
    width: 180px;
    height: 180px;
    background: #fff4a3;
    border-radius: 50%;
    right: 8%;
    top: 7%;
    box-shadow: 0 0 80px #fff4a3;
}

/* Contenido principal */
.contenido {
    position: relative;
    z-index: 5;
    min-height: 100vh;
    padding: 25px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.fecha {
    font-size: .95rem;
    letter-spacing: 3px;
    margin-bottom: 12px;
    opacity: .8;
}

h1 {
    font-size: clamp(2.8rem, 12vw, 5rem);
    color: #8c6100;
    text-shadow: 0 3px 15px rgba(255,255,255,.8);
}

.subtitulo {
    margin-top: 10px;
    max-width: 500px;
    font-size: 1.15rem;
    line-height: 1.6;
}

/* Flor */
.flor {
    position: relative;
    width: 170px;
    height: 170px;
    margin: 25px 0;
    animation: flotar 3s ease-in-out infinite;
}

.petalo {
    position: absolute;
    width: 60px;
    height: 90px;
    background: #ffd21f;
    border-radius: 50%;
    left: 55px;
    top: 38px;
    transform-origin: center bottom;
    box-shadow: 0 4px 10px rgba(120,80,0,.2);
}

.petalo:nth-child(1) { transform: rotate(0deg) translateY(-28px); }
.petalo:nth-child(2) { transform: rotate(45deg) translateY(-28px); }
.petalo:nth-child(3) { transform: rotate(90deg) translateY(-28px); }
.petalo:nth-child(4) { transform: rotate(135deg) translateY(-28px); }
.petalo:nth-child(5) { transform: rotate(180deg) translateY(-28px); }
.petalo:nth-child(6) { transform: rotate(225deg) translateY(-28px); }
.petalo:nth-child(7) { transform: rotate(270deg) translateY(-28px); }
.petalo:nth-child(8) { transform: rotate(315deg) translateY(-28px); }

.centro {
    position: absolute;
    width: 60px;
    height: 60px;
    background: #754900;
    border-radius: 50%;
    left: 55px;
    top: 55px;
    z-index: 2;
}

/* Botón */
button {
    border: none;
    background: #8b6100;
    color: white;
    padding: 15px 28px;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(80,50,0,.25);
    transition: .3s;
}

button:hover {
    transform: scale(1.07);
}

/* Carta */
.carta-fondo {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: none;
    justify-content: center;
    align-items: center;
    padding: 22px;
    background: rgba(70,50,0,.5);
    backdrop-filter: blur(7px);
}

.carta {
    width: min(500px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    padding: 32px 25px;
    border-radius: 25px;
    background: #fffdf3;
    box-shadow: 0 20px 60px rgba(0,0,0,.3);
    animation: aparecer .6s ease;
}

.carta h2 {
    color: #d39a00;
    margin-bottom: 20px;
}

.carta p {
    line-height: 1.8;
    font-size: 1.05rem;
}

.cerrar {
    margin-top: 25px;
    background: #d39a00;
}

/* Elementos flotantes */
.petalo-caida,
.corazon {
    position: fixed;
    pointer-events: none;
    z-index: 10;
}

.petalo-caida {
    top: -40px;
    animation: caer linear forwards;
}

.corazon {
    bottom: -30px;
    animation: subir linear forwards;
}

/* Animaciones */
@keyframes caer {
    to {
        transform: translateY(110vh) rotate(360deg);
        opacity: 0;
    }
}

@keyframes subir {
    to {
        transform: translateY(-110vh);
        opacity: 0;
    }
}

@keyframes flotar {
    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }
}

@keyframes aparecer {
    from {
        opacity: 0;
        transform: scale(.7) translateY(30px);
    }

    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}
</style>
</head>

<body>

<div class="fondo">
    <div class="sol"></div>
</div>

<main class="contenido">

    <div class="fecha">
        21 DE SEPTIEMBRE 🌻
    </div>

    <h1>Noni ✨🤍</h1>

    <p class="subtitulo">
        Hoy quería regalarte algo especial...
        así que decidí hacerte un pequeño detalle
        con mis propias manos. 💛
    </p>

    <div class="flor">

        <div class="petalo"></div>
        <div class="petalo"></div>
        <div class="petalo"></div>
        <div class="petalo"></div>
        <div class="petalo"></div>
        <div class="petalo"></div>
        <div class="petalo"></div>
        <div class="petalo"></div>

        <div class="centro"></div>

    </div>

    <button onclick="abrirCarta()">
        💌 Hay algo para ti
    </button>

</main>

<!-- CARTA -->

<div class="carta-fondo" id="carta">

    <div class="carta">

        <h2>🌻 Para Noni ✨🤍</h2>

        <p>

            Hoy, 21 de septiembre, es el día de
            las flores amarillas. 🌻
            <br><br>

            Y aunque podría simplemente regalarte
            unas flores, quise hacer algo diferente.
            <br><br>

            Quise crear este pequeño detalle para ti,
            porque hay personas que merecen algo
            hecho especialmente para ellas. ✨
            <br><br>

            Puede que estas flores estén hechas
            con código, pero cada parte de esta
            página fue pensada para sacarte
            una sonrisa. 💛
            <br><br>

            Espero que este pequeño detalle te
            recuerde lo especial que eres.
            <br><br>

            <strong>
                Feliz día de las flores amarillas,
                Noni. 🌻✨🤍
            </strong>

        </p>

        <button class="cerrar" onclick="cerrarCarta()">
            🤍 Cerrar
        </button>

    </div>

</div>

<script>

function abrirCarta() {
    document.getElementById("carta").style.display = "flex";

    for (let i = 0; i < 25; i++) {
        crearCorazon();
    }
}

function cerrarCarta() {
    document.getElementById("carta").style.display = "none";
}

function crearPetalo() {

    const petalo = document.createElement("div");

    petalo.className = "petalo-caida";
    petalo.innerHTML = "🌻";

    petalo.style.left =
        Math.random() * 100 + "vw";

    petalo.style.fontSize =
        (15 + Math.random() * 20) + "px";

    petalo.style.animationDuration =
        (4 + Math.random() * 5) + "s";

    document.body.appendChild(petalo);

    setTimeout(() => {
        petalo.remove();
    }, 9000);
}

function crearCorazon() {

    const corazon = document.createElement("div");

    corazon.className = "corazon";
    corazon.innerHTML = "🤍";

    corazon.style.left =
        Math.random() * 100 + "vw";

    corazon.style.fontSize =
        (15 + Math.random() * 15) + "px";

    corazon.style.animationDuration =
        (3 + Math.random() * 3) + "s";

    document.body.appendChild(corazon);

    setTimeout(() => {
        corazon.remove();
    }, 6000);
}

setInterval(crearPetalo, 700);
setInterval(crearCorazon, 1800);

</script>

</body>
</html>
